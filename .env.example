APP_NAME="RAGFlowX"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000
API_PREFIX="/api/v1"

# LLM Provider Selection:  gemini | openai
LLM_PROVIDER="LLM_PROVIDER"

# Model name for generation (used by gemini/openai providers)
LLM_MODEL_NAME="LLM_MODEL_NAME"

# API keys for live LLM testing — replace placeholders with your real keys
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"

# Security & Reliability Settings
AUTH_ENABLED=True
BOOTSTRAP_API_KEY="your-bootstrap-api-key-min-16-chars"
API_KEY_PEPPER="your-pepper-string-min-32-chars-random"
RATE_LIMIT_ENABLED=True
ANTIVIRUS_ENABLED=False
